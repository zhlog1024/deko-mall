<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.deko.mall.ums.mapper.UmsConfigMapper">


    <select id="getConfigValue" resultType="java.math.BigDecimal">
        SELECT config_value
        FROM ums_config
        WHERE model = #{model}
          AND biz = #{biz}
    </select>
    <select id="getConfigValueByModel" resultType="com.deko.mall.ums.model.entity.UmsConfig">
        SELECT *
        FROM ums_config
        WHERE model = #{model}
    </select>
</mapper>
