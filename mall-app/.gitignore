# ============================================
# Mall App 移动端项目 .gitignore
# ============================================

# ==================== 依赖目录 ====================
node_modules/

# ==================== 编译输出 ====================
dist/
.hbuilderx/
resources/

# ==================== 日志文件 ====================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ==================== 编辑器配置 ====================
.idea/
.vscode/
.project
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
*.bak

# ==================== 系统文件 ====================
.DS_Store
Thumbs.db

# ==================== 环境变量 ====================
.env.local
.env.*.local
.env_mode

# ==================== 微信开发者工具 ====================
private.*.key
project.private.config.json

# ==================== Android 签名证书（敏感信息）====================
certs/
*.keystore
*.jks
*.p12
