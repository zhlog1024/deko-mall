# 复制为 deploy/.env 后按需修改
# docker compose 会自动加载与本文件同目录的 .env
# 前端宿主机端口与本地开发一致：admin 9527 / scm 9528 / app H5 8080（容器内 Nginx 仍为 80）

# ---- 宿主机端口（仅绑定 127.0.0.1）----
ADMIN_PORT=9527
SCM_PORT=9528
APP_PORT=8080
GATEWAY_PORT=9999
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
# 9000 常被本机 mall-auth 占用，默认把 MinIO API 映到 9002
MINIO_PORT=9002
MINIO_UI_PORT=9001
# 浏览器/App 可访问的对象前缀（需与 MINIO_PORT、MINIO_BUCKET 一致）
MINIO_CUSTOM_DOMAIN=http://127.0.0.1:9002/deko-mall
NACOS_PORT=8848
# 修改 NACOS_PORT 时必须同步：NACOS_GRPC_PORT = NACOS_PORT + 1000
NACOS_GRPC_PORT=9848

# ---- 中间件凭据（默认值与 compose 内一致）----
MYSQL_ROOT_PASSWORD=deko_root_2024
REDIS_PASSWORD=deko_redis_2024
RABBITMQ_USER=deko
RABBITMQ_PASSWORD=deko_mq_2024
MINIO_ROOT_USER=deko
MINIO_ROOT_PASSWORD=deko_minio_2024
MINIO_BUCKET=deko-mall

# ---- Nacos ----
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=deko-mall-docker
NACOS_GROUP=DEFAULT_GROUP
# NACOS_AUTH_KEY=
# NACOS_AUTH_VALUE=
# NACOS_AUTH_TOKEN=

# ---- 后端 JVM（每个业务容器）----
# JAVA_OPTS=-Xms64m -Xmx256m -XX:ActiveProcessorCount=2 -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom
